# ===================================================================
# PORTFOLIO BACKEND — ENVIRONMENT VARIABLES
# ===================================================================
# Copy this file as .env and fill in real values.
# NEVER commit .env to version control!
# ===================================================================

# --- Server ---
PORT=4000
NODE_ENV=production

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
JWT_EXPIRES_IN=2h

# --- CORS ---
ALLOWED_ORIGINS=https://alarasysn.com,https://www.alarasysn.com,http://localhost:5173,http://127.0.0.1:5500

# --- Admin Credentials (single admin, local — no Firebase Auth) ---
ADMIN_EMAIL=admin@alarasysn.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Breach Alert (Discord Webhook) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# --- Alert Thresholds ---
FAILED_LOGIN_ALERT_THRESHOLD=5
