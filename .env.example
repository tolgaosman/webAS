# Read by docker-compose.yml itself (for the ${DB_...} interpolation in
# the mysql service) — copy to .env at the repo root on the Hetzner host.
# This is separate from api/.env, which Laravel reads inside the php
# container; DB_DATABASE/DB_USERNAME/DB_PASSWORD here must match the
# same-named values in api/.env exactly.

DB_DATABASE=webas
DB_USERNAME=webas
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
