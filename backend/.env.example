# ===================================================================
# PORTFOLIO BACKEND — ENVIRONMENT VARIABLES
# ===================================================================
# Copy this file as .env and fill in real values.
# NEVER commit .env to version control!
# ===================================================================

# --- Server ---
PORT=4000
NODE_ENV=production

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
JWT_EXPIRES_IN=7d

# --- Firebase Admin SDK ---
# Option A: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
#
# Option B: Inline JSON (for Render / cloud deployments)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- CORS ---
ALLOWED_ORIGINS=https://alarasoysan.com,https://www.alarasoysan.com,http://localhost:5173,http://127.0.0.1:5500

# --- Admin Credentials ---
ADMIN_EMAIL=admin@alarasoysan.com

# --- Password Reset ---
RESET_TOKEN_EXPIRY_MINUTES=30

# --- Breach Alert (Discord Webhook) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# --- Alert Thresholds ---
FAILED_LOGIN_ALERT_THRESHOLD=5

# --- Firebase Public Client Config (For Frontend Storage) ---
FIREBASE_API_KEY=AIzaSyCXrqW0VXXseVKOiygXYA5At6aZiqIH5dM
FIREBASE_AUTH_DOMAIN=alaraportfolio-e750c.firebaseapp.com
FIREBASE_PROJECT_ID=alaraportfolio-e750c
FIREBASE_STORAGE_BUCKET=alaraportfolio-e750c.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=862474406851
FIREBASE_APP_ID=1:862474406851:web:3ad852f76c3422b15dcb76
