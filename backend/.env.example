APP_NAME=webAS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://alarasysn.com
APP_LOCALE=tr

LOG_CHANNEL=stack
LOG_LEVEL=error

# MySQL on Hetzner (§Faz 8) — same "mysql" service name as docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webas
DB_USERNAME=webas
DB_PASSWORD=

# Rate-limit counters + failed-login alert cooldowns (§Faz 6) — must be
# Redis (or another cross-process store), not "file"/"array", because
# php-fpm runs multiple worker processes that don't share memory the way
# the legacy single-process Express server did. REDIS_CLIENT=phpredis
# requires the redis PECL extension (see backend/Dockerfile) — without
# it every request 500s, since throttle:global wraps every route.
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# The API is stateless (auth is the auth_token JWT cookie below, not a
# Laravel session) — "array" avoids needing Redis for sessions too.
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# ── Values carried over from legacy/backend/.env.example ──
# IMPORTANT: generate a FRESH value for cutover, do not reuse the one
# from legacy/backend/.env — that file sat in a working directory and
# should be treated as compromised (min 32 chars).
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
ALLOWED_ORIGINS=https://alarasysn.com,https://www.alarasysn.com,http://localhost:5173,http://127.0.0.1:5500
ADMIN_EMAIL=admin@alarasysn.com
ADMIN_PASSWORD=change-me-to-a-strong-password
DISCORD_WEBHOOK_URL=
FAILED_LOGIN_ALERT_THRESHOLD=5

# public_uploads disk root — must resolve to the same directory nginx
# serves via `alias /var/www/uploads/` (bind-mounted, see docker-compose.yml)
UPLOADS_PATH=/var/www/uploads
